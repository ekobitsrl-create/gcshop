# Admin access (comma-separated ChatGPT account emails)
ADMIN_EMAILS=info@ekobit.it

# PayPal REST API — keep real values only in hosted environment variables
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Bonifico bancario — add the real banking details before enabling live checkout
BANK_ACCOUNT_HOLDER=Ekobit SRL
BANK_IBAN=
BANK_BIC=

# Public storefront settings
NEXT_PUBLIC_STORE_CURRENCY=EUR
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD_CENTS=0
